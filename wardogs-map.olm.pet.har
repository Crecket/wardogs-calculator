              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=leZ3yrPjd%2BrPOmSzisU718A49lot7LkC4L%2B%2F5jkgqkXnbTuI1Hbo5aMNRxXt0OdkjZP7Mc%2FChN7%2FpeKSZciBdGg0QlF2OChOnDAPZz0VwjyOsSxls%2FHI7GsjJvSbnehmYQj7EGhj\"}]}"
