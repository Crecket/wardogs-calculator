            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n\n<html lang=\"en\">\n<head>\n<script>window.__WARDOGS_ANALYTICS_DISABLED__ = true;</script>\n<meta content=\"202028ddb3b841b2\" name=\"yandex-verification\"/>\n<meta content=\"LtfWehCgGAvT8AdpuHGFaCUKBNsmPOEk4J3YkqZEJvM\" name=\"google-site-verification\"/>\n<meta charset=\"utf-8\"/><meta content=\"42ad0cb7506d\" name=\"asset-version\"/>\n<meta content=\"default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://wardogs-tiles.olm.pet; connect-src 'self' https://wardogs-tiles.olm.pet wss://wardogs-map-sync.olm.pet https://wardogs-map-sync.olm.pet; frame-src 'none'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; worker-src 'self' blob:; upgrade-insecure-requests\" http-equiv=\"Content-Security-Policy\"/>\n<meta content=\"no-referrer\" name=\"referrer\"/>\n<meta content=\"width=device-width,initial-scale=1\" name=\"viewport\"/>\n<script src=\"js/core/mobile-redirect.js?v=42ad0cb7506d\"></script>\n<title>WARDOGS Artillery Calculator | L81 Mortar, SPH-2 &amp; Maps</title>\n<link href=\"assets/favicon.png\" rel=\"icon\"/>\n<link href=\"style.css?v=42ad0cb7506d\" rel=\"stylesheet\"/>\n<meta content=\"Free WARDOGS L81 Mortar and SPH-2 artillery calculator with Bakurani, Ozeti and Zestafona maps, Terrain3D MIL correction and tactical tools.\" name=\"description\"/>\n<meta content=\"index, follow, max-image-preview:large\" name=\"robots\"/>\n<meta content=\"#101316\" name=\"theme-color\"/>\n<link href=\"https://wardogs-artillery.com/\" rel=\"canonical\"/>\n<link href=\"https://wardogs-artillery.com/mobile/\" media=\"only screen and (max-width: 900px)\" rel=\"alternate\"/>\n<meta content=\"website\" property=\"og:type\"/>\n<meta content=\"WARDOGS Artillery Calculator\" property=\"og:site_name\"/>\n<meta content=\"WARDOGS Artillery Calculator | L81 Mortar, SPH-2 &amp; Maps\" property=\"og:title\"/>\n<meta content=\"Free WARDOGS L81 Mortar and SPH-2 artillery calculator with Bakurani, Ozeti and Zestafona maps, Terrain3D MIL correction and tactical tools.\" property=\"og:description\"/>\n<meta content=\"https://wardogs-artillery.com/\" property=\"og:url\"/>\n<meta content=\"https://wardogs-artillery.com/assets/preview.png\" property=\"og:image\"/>\n<meta content=\"image/png\" property=\"og:image:type\"/>\n<meta content=\"1200\" property=\"og:image:width\"/>\n<meta content=\"675\" property=\"og:image:height\"/>\n<meta content=\"WARDOGS Artillery Calculator tactical map and artillery calculation interface\" property=\"og:image:alt\"/>\n<meta content=\"en_GB\" property=\"og:locale\"/>\n<meta content=\"ru_RU\" property=\"og:locale:alternate\"/>\n<meta content=\"uk_UA\" property=\"og:locale:alternate\"/>\n<meta content=\"de_DE\" property=\"og:locale:alternate\"/>\n<meta content=\"fr_FR\" property=\"og:locale:alternate\"/>\n<meta content=\"es_ES\" property=\"og:locale:alternate\"/>\n<meta content=\"pl_PL\" property=\"og:locale:alternate\"/>\n<meta content=\"pt_PT\" property=\"og:locale:alternate\"/>\n<meta content=\"summary_large_image\" name=\"twitter:card\"/>\n<meta content=\"https://wardogs-artillery.com/assets/preview.png\" name=\"twitter:image\"/>\n<meta content=\"WARDOGS Artillery Calculator | L81 Mortar, SPH-2 &amp; Maps\" name=\"twitter:title\"/>\n<meta content=\"Free WARDOGS L81 Mortar and SPH-2 artillery calculator with Bakurani, Ozeti and Zestafona maps, Terrain3D MIL correction and tactical tools.\" name=\"twitter:description\"/>\n<script type=\"application/ld+json\">{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"WebApplication\",\n  \"name\": \"WARDOGS Artillery Calculator\",\n  \"url\": \"https://wardogs-artillery.com/\",\n  \"image\": \"https://wardogs-artillery.com/assets/preview.png\",\n  \"description\": \"Free WARDOGS L81 Mortar and SPH-2 artillery calculator with Bakurani, Ozeti and Zestafona maps, Terrain3D MIL correction and tactical tools.\",\n  \"applicationCategory\": \"GameApplication\",\n  \"operatingSystem\": \"Any\",\n  \"isAccessibleForFree\": true,\n  \"inLanguage\": \"en\",\n  \"browserRequirements\": \"Requires JavaScript and a modern web browser\",\n  \"codeRepository\": \"https://github.com/apollyon-sys/wardogs-calculator\",\n  \"alternateName\": [\n    \"WARDOGS Artillery Calculator & Tactical Map\",\n    \"WARDOGS Arty Calc\",\n    \"WARDOGS L81 Mortar Calculator\"\n  ],\n  \"softwareVersion\": \"1.8.0\",\n  \"featureList\": [\n    \"WARDOGS L81 Mortar calculator and firing solutions\",\n    \"SPH-2 LOW and HIGH firing solutions\",\n    \"Experimental Terrain3D MIL correction for SPH-2\",\n    \"Bakurani interactive tactical map with terrain contours\",\n    \"Ozeti tactical map with terrain contours\",\n    \"Zestafona interactive tactical map with terrain contours\",\n    \"Saved target firing summaries\",\n    \"Ruler and drawing tools\",\n    \"Tactical map markers\"\n  ]\n}</script>\n</head>\n<body>\n<main>\n<aside>\n<!-- MAP -->\n<div class=\"section\">\n<h2 data-i18n=\"map\">Map</h2>\n<select id=\"mapSelect\"></select>\n</div>\n<!-- WEAPON -->\n<div class=\"section\">\n<h2 data-i18n=\"weapon\">Weapon</h2>\n<select id=\"weapon\"></select>\n<div class=\"result\" style=\"margin-top:8px\">\n<div class=\"row\">\n<span data-i18n=\"weaponRange\">Max range</span>\n<b id=\"range\">—</b>\n</div>\n<div class=\"row\">\n<span data-i18n=\"targetStatus\">Target status</span>\n<b id=\"rangeStatus\">—</b>\n</div>\n</div>\n</div>\n<!-- POINT SELECTION -->\n<div class=\"section\">\n<h2 data-i18n=\"pointSelection\">Point selection</h2>\n<div class=\"mode\">\n<div class=\"mode-option\">\n<button class=\"active\" data-i18n=\"artillery\" id=\"originMode\">Artillery</button>\n</div>\n<div class=\"mode-option\">\n<button data-i18n=\"target\" id=\"targetMode\">Target</button>\n</div>\n</div>\n<label data-i18n=\"artilleryXY\">Artillery X / Y</label>\n<div class=\"coordinate-row\">\n<div class=\"grid2\">\n<input id=\"ox\" step=\"0.01\" type=\"number\" value=\"2000\"/>\n<input id=\"oy\" step=\"0.01\" type=\"number\" value=\"2000\"/>\n</div>\n<div class=\"point-coordinate-actions\">\n<button aria-label=\"Copy coordinates\" class=\"coordinate-action\" id=\"coordinateOriginCopy\" title=\"Copy coordinates\" type=\"button\"><svg aria-hidden=\"true\" class=\"coordinate-action-icon\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewBox=\"0 0 24 24\" width=\"14\"><rect height=\"13\" rx=\"2\" width=\"13\" x=\"9\" y=\"9\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg aria-hidden=\"true\" class=\"coordinate-action-done\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" viewBox=\"0 0 24 24\" width=\"14\"><path d=\"m5 13 4 4 10-10\"/></svg></button>\n<button aria-label=\"Paste coordinates\" class=\"coordinate-action\" id=\"coordinateOriginPaste\" title=\"Paste coordinates\" type=\"button\"><svg aria-hidden=\"true\" class=\"coordinate-action-icon\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewBox=\"0 0 24 24\" width=\"14\"><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"/><rect height=\"4\" rx=\"1\" width=\"8\" x=\"8\" y=\"2\"/></svg><svg aria-hidden=\"true\" class=\"coordinate-action-done\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" viewBox=\"0 0 24 24\" width=\"14\"><path d=\"m5 13 4 4 10-10\"/></svg></button>\n</div>\n</div>\n<label data-i18n=\"targetXY\">Target X / Y</label>\n<div class=\"coordinate-row\">\n<div class=\"grid2\">\n<input id=\"tx\" step=\"0.01\" type=\"number\" value=\"2500\"/>\n<input id=\"ty\" step=\"0.01\" type=\"number\" value=\"2500\"/>\n</div>\n<div class=\"point-coordinate-actions\">\n<button aria-label=\"Copy coordinates\" class=\"coordinate-action\" id=\"coordinateTargetCopy\" title=\"Copy coordinates\" type=\"button\"><svg aria-hidden=\"true\" class=\"coordinate-action-icon\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewBox=\"0 0 24 24\" width=\"14\"><rect height=\"13\" rx=\"2\" width=\"13\" x=\"9\" y=\"9\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg aria-hidden=\"true\" class=\"coordinate-action-done\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" viewBox=\"0 0 24 24\" width=\"14\"><path d=\"m5 13 4 4 10-10\"/></svg></button>\n<button aria-label=\"Paste coordinates\" class=\"coordinate-action\" id=\"coordinateTargetPaste\" title=\"Paste coordinates\" type=\"button\"><svg aria-hidden=\"true\" class=\"coordinate-action-icon\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewBox=\"0 0 24 24\" width=\"14\"><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"/><rect height=\"4\" rx=\"1\" width=\"8\" x=\"8\" y=\"2\"/></svg><svg aria-hidden=\"true\" class=\"coordinate-action-done\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" viewBox=\"0 0 24 24\" width=\"14\"><path d=\"m5 13 4 4 10-10\"/></svg></button>\n</div>\n</div>\n</div>\n<!-- RESULT -->\n<div class=\"section\">\n<h2 data-i18n=\"result\">Result</h2>\n<div class=\"result solution-result\">\n<div class=\"solution-primary-grid\">\n<div class=\"solution-metric\">\n<span class=\"solution-metric-label\" data-i18n=\"distance\">Distance</span>\n<strong class=\"solution-metric-value\" id=\"distm\">—</strong>\n</div>\n<div class=\"solution-metric\">\n<span class=\"solution-metric-label\" data-i18n=\"azimuth\">AZIMUTH</span>\n<strong class=\"solution-metric-value\" id=\"angle\">—</strong>\n</div>\n</div>\n<div class=\"solution-mil-grid\" data-arcs=\"2\" id=\"milGrid\">\n<div class=\"solution-metric solution-metric-highlight\" id=\"milLowCard\">\n<span class=\"solution-metric-label\" data-i18n=\"lowArc\" id=\"milLowLabel\">Low arc</span>\n<strong class=\"solution-metric-value\" id=\"milLow\">—</strong>\n</div>\n<div class=\"solution-metric solution-metric-highlight\" id=\"milHighCard\">\n<span class=\"solution-metric-label\" data-i18n=\"highArc\" id=\"milHighLabel\">High arc</span>\n<strong class=\"solution-metric-value\" id=\"milHigh\">—</strong>\n</div>\n</div>\n<div class=\"solution-metric-sub solution-mil-note\" id=\"milAlt\" hidden></div>\n<div class=\"solution-flight\" id=\"flightTimes\" hidden>\n<span class=\"solution-flight-label\" data-i18n=\"flightTime\">Time of flight</span>\n<div class=\"solution-flight-badges\" id=\"flightTimeBadges\"></div>\n</div>\n<div class=\"solution-terrain-note\" id=\"terrainNote\" hidden></div>\n<div class=\"solution-secondary-grid\">\n<div class=\"solution-secondary-item\"><span>ΔX</span><b id=\"dx\">—</b></div>\n<div class=\"solution-secondary-item\"><span>ΔY</span><b id=\"dy\">—</b></div>\n</div>\n</div>\n</div>\n<!-- CONTROLS -->\n<div class=\"section\">\n<h2 data-i18n=\"controls\">Controls</h2>\n<div class=\"grid2\">\n<button id=\"zoomOut\">\n                    −\n                </button>\n<button id=\"zoomIn\">\n                    +\n                </button>\n</div>\n<button data-i18n=\"fit\" id=\"fit\" style=\"margin-top:7px\">Fit map</button>\n<button data-i18n=\"clear\" id=\"clear\" style=\"margin-top:7px\">Reset</button>\n<div class=\"sidebar-controls\" id=\"sidebarControls\"></div>\n</div>\n</aside>\n<button aria-label=\"Hide sidebar\" aria-expanded=\"true\" class=\"sidebar-toggle\" id=\"sidebarToggle\" title=\"Hide sidebar\" type=\"button\">\n<span aria-hidden=\"true\" class=\"sidebar-toggle-icon\">‹</span>\n</button>\n<!-- WORKSPACE -->\n<section class=\"workspace\">\n<div class=\"map\">\n<canvas id=\"canvas\"></canvas>\n<!-- CURSOR -->\n<div class=\"cursor-coords\" id=\"cursorCoords\">\n<span class=\"cursor-y\">\n          y0.00\n        </span>\n<span class=\"cursor-x\">\n          x0.00\n        </span>\n</div>\n<!-- MIL UNDER CURSOR -->\n<div class=\"mil-cursor\" id=\"milCursor\">\n<div class=\"mil-cursor-range\"></div>\n<div class=\"mil-cursor-arcs\"></div>\n</div>\n<!-- GUNS -->\n<div class=\"saved-targets guns-panel\">\n<div class=\"saved-targets-header\">\n<span data-i18n=\"gunsPanel\">Guns</span>\n<span class=\"saved-targets-count\" id=\"gunsCount\">1</span>\n</div>\n<div class=\"saved-targets-list\" id=\"gunsList\"></div>\n<div class=\"saved-target-actions\">\n<button class=\"save-target-button\" data-i18n=\"addGun\" id=\"addGun\" type=\"button\">Add gun</button>\n</div>\n</div>\n<!-- SAVED TARGETS -->\n<div class=\"saved-targets\">\n<div class=\"saved-targets-header\">\n<span data-i18n=\"savedTargets\">Saved targets</span>\n<span class=\"saved-targets-count\" id=\"savedTargetsCount\">\n      0\n    </span>\n</div>\n<div class=\"saved-targets-list\" id=\"savedTargetsList\"></div>\n<div class=\"saved-target-options\">\n<label class=\"save-artillery-option\">\n<input id=\"saveArtilleryPosition\" type=\"checkbox\"/>\n<span data-i18n=\"saveArtilleryPosition\">New targets move the artillery too</span>\n</label>\n</div>\n<div class=\"saved-target-actions\">\n<button class=\"save-target-button\" data-i18n=\"save\" id=\"saveTarget\" type=\"button\">Save</button>\n<div aria-live=\"polite\" class=\"saved-target-transfer-status\" id=\"savedTargetsTransferStatus\"></div>\n</div>\n</div>\n<!-- MAP TOOLS -->\n<div class=\"map-tools\" id=\"mapTools\">\n<div class=\"map-tool-popover map-tool-palette\" id=\"pencilPalette\"></div>\n<div class=\"map-tool-popover map-tool-shape-palette\" id=\"shapePalette\"></div>\n<div class=\"map-tool-popover map-tool-marker-picker\" id=\"markerPicker\"></div>\n<div class=\"map-tool-popo