              "value": "strict-origin-when-cross-origin"
            },
            {
              "name": "report-to",
              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=aWbhSl1XxV1Fu6dZThGswOr%2BhNGXLjfgk%2FlYbOrXdRVmhSJopZ58TbNvedrojrBQaZYF41Fj5lWPiAeWqpSYqOjyldXyC5kYyRKufioLXBuakzIiWVkbb%2FbkE8pJc9%2BvvovpW1K9\"}]}"
            },
            {
              "name": "server",
              "value": "cloudflare"
