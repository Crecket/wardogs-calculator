            "mimeType": "application/javascript",
            "text": "/* =========================\n   CURSOR\n   ========================= */\n\nfunction updateCursor(e, canvasRect) {\n\n    const cursor =\n        $('cursorCoords');\n\n    if (\n        typeof isMapLayerVisible === 'function' &&\n        !isMapLayerVisible('cursorCoords')\n    ) {\n        if (cursor) {\n            setStyle(cursor, 'display', 'none');\n        }\n\n        return;\n    }\n\n    const rect =\n        canvasRect ||\n        c.getBoundingClientRect();\n\n    const x =\n        e.clientX -\n        rect.left;\n\n    const y =\n        e.clientY -\n        rect.top;\n\n    const world =\n        toWorld(\n            x,\n            y\n        );\n\n    const bounds =\n        getViewBounds();\n\n    if (\n        world.x <\n        bounds.minX ||\n        world.x >\n        bounds.maxX ||\n        world.y <\n        bounds.minY ||\n        world.y >\n        bounds.maxY\n    ) {\n\n        setStyle(\n            $('cursorCoords'),\n            'display',\n            'none'\n        );\n\n        return;\n    }\n\n    if (!cursor) {\n        return;\n    }\n\n    setStyle(\n        cursor,\n        'display',\n        'block'\n    );\n\n    setStyle(\n        cursor,\n        'left',\n        `${x + 14}px`\n    );\n\n    setStyle(\n        cursor,\n        'top',\n        `${y + 14}px`\n    );\n\n    setText(\n        cursor.querySelector(\n            '.cursor-x'\n        ),\n        `x${formatGameCoordinate(world.x)}`\n    );\n\n    setText(\n        cursor.querySelector(\n            '.cursor-y'\n        ),\n        `y${formatGameCoordinate(world.y)}`\n    );\n}\n"
          },
          "redirectURL": "",
