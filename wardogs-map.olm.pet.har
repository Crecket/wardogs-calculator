            "text": "{\n  \"id\": \"zestafona\",\n  \"name\": \"Zestafona\",\n  \"w\": 32,\n  \"h\": 32,\n  \"bounds\": {\n    \"minX\": 19.9,\n    \"maxX\": 124.89,\n    \"minY\": 50.7,\n    \"maxY\": 141.9\n  },\n  \"tiles\": {\n    \"path\": \"https://wardogs-tiles.olm.pet/zestafona\",\n    \"tileSize\": 256,\n    \"minZoom\": 0,\n    \"maxZoom\": 7,\n    \"extension\": \"webp\"\n  },\n  \"markers\": [\n    {\n      \"icon\": \"tower\",\n      \"x\": 7017.2672,\n      \"y\": 10017.17,\n      \"label\": \"Tower 3\",\n      \"minZoom\": 0.4,\n      \"maxZoom\": 100\n    },\n    {\n      \"icon\": \"tower\",\n      \"x\": 6859.9808,\n      \"y\": 10415.3,\n      \"label\": \"Tower 1\",\n      \"minZoom\": 0.4,\n      \"maxZoom\": 100\n    },\n    {\n      \"icon\": \"tower\",\n      \"x\": 7289.2416,\n      \"y\": 10507.0592,\n      \"label\": \"Tower 2\",\n      \"minZoom\": 0.4,\n      \"maxZoom\": 100\n    },\n    {\n      \"icon\": \"valkyra\",\n      \"x\": 3943.6288,\n      \"y\": 12494.4384,\n      \"label\": \"VALKYRA Spawn\",\n      \"minZoom\": 10,\n      \"maxZoom\": 100\n    },\n    {\n      \"icon\": \"manticore\",\n      \"x\": 10466.0992,\n      \"y\": 11508.1216,\n      \"label\": \"MANTICORE Spawn\",\n      \"minZoom\": 10,\n      \"maxZoom\": 100\n    },\n    {\n      \"icon\": \"lonestar\",\n      \"x\": 6800.9984,\n      \"y\": 6660.096,\n      \"label\": \"LONESTAR\",\n      \"minZoom\": 10,\n      \"maxZoom\": 100\n    },\n    {\n      \"icon\": \"spawn_board\",\n      \"x\": 3889.5616,\n      \"y\": 12486.2464,\n      \"label\": \"Spawn Board\",\n      \"minZoom\": 10,\n      \"maxZoom\": 100\n    },\n    {\n      \"icon\": \"garage_vendor\",\n      \"x\": 10466.0992,\n      \"y\": 11454.0544,\n      \"label\": \"Garage Vendor\",\n      \"minZoom\": 10,\n      \"maxZoom\": 100\n    },\n    {\n      \"icon\": \"spawn_board\",\n      \"x\": 10505.4208,\n      \"y\": 11529.4208,\n      \"label\": \"Spawn Board\",\n      \"minZoom\": 10,\n      \"maxZoom\": 100\n    },\n    {\n      \"icon\": \"spawn_board\",\n      \"x\": 6823.936,\n      \"y\": 6632.243200000001,\n      \"label\": \"Spawn Board\",\n      \"minZoom\": 10,\n      \"maxZoom\": 100\n    },\n    {\n      \"icon\": \"garage_vendor\",\n      \"x\": 6782.976,\n      \"y\": 6650.265600000001,\n      \"label\": \"Garage Vendor\",\n      \"minZoom\": 10,\n      \"maxZoom\": 100\n    },\n    {\n      \"icon\": \"garage_vendor\",\n      \"x\": 3940.352,\n      \"y\": 12479.6928,\n      \"label\": \"Garage Vendor\",\n      \"minZoom\": 10,\n      \"maxZoom\": 100\n    }\n  ],\n  \"polygons\": [\n    {\n      \"color\": \"#82c596\",\n      \"fillOpacity\": 0.12,\n      \"strokeWidth\": 2,\n      \"dashed\": true,\n      \"label\": \"MANTICORE Spawn\",\n      \"points\": [\n        {\n          \"x\": 10330.11,\n          \"y\": 11170.61\n        },\n        {\n          \"x\": 10190.84,\n          \"y\": 11631\n        },\n        {\n          \"x\": 10651.23,\n          \"y\": 11768.62\n        },\n        {\n          \"x\": 10788.86,\n          \"y\": 11309.87\n        }\n      ]\n    },\n    {\n      \"color\": \"#d86666\",\n      \"fillOpacity\": 0.12,\n      \"strokeWidth\": 2,\n      \"dashed\": true,\n      \"label\": \"VALKYRA Spawn\",\n      \"points\": [\n        {\n          \"x\": 4027.18,\n          \"y\": 12188.05\n        },\n        {\n          \"x\": 3570.07,\n          \"y\": 12335.51\n        },\n        {\n          \"x\": 3717.5296,\n          \"y\": 12792.62\n        },\n        {\n          \"x\": 4174.64,\n          \"y\": 12645.17\n        }\n      ]\n    },\n    {\n      \"color\": \"#5fa8d3\",\n      \"fillOpacity\": 0.12,\n      \"strokeWidth\": 2,\n      \"dashed\": true,\n      \"label\": \"LONESTAR Spawn\",\n      \"points\": [\n        {\n          \"x\": 6512.64,\n          \"y\": 6481.51\n        },\n        {\n          \"x\": 6630.6,\n          \"y\": 6946.81\n        },\n        {\n          \"x\": 7095.91,\n       