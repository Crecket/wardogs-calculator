          "cookies": [],
          "content": {
            "size": 3112,
            "mimeType": "application/json",
            "text": "{\n    \"schema\": \"wardogs-projectile-model-v2\",\n    \"sourceNote\": \"Per-arc source. firing-range-fit: fitted to the 2026-09-02 in-game measurements in docs/firing-range-measurements.md. vacuum-fit: least-squares vacuum fit to data/weapons.json by scripts/fit-ballistics.mjs, which rewrites only arcs of that source. dragPerMeter is the quadratic drag coefficient k in a = -k |v| v; the launch angle is angleOffsetDeg + anglePerMilDeg * mil.\",\n    \"generatedAt\": \"2026-09-02\",\n    \"gravity\": 9.81,\n    \"weapons\": {\n        \"mortar\": {\n            \"single\": {\n                \"branch\": \"high\",\n                \"source\": \"vacuum-fit\",\n                \"muzzleVelocity\": 86.7,\n                \"dragPerMeter\": 0,\n                \"angleOffsetDeg\": 52.5,\n                \"anglePerMilDeg\": 0.0375,\n                \"rmsMeters\": 8.11,\n                \"measuredFlightTimes\": [\n                    [\n                        150,\n                        16.5\n                    ],\n                    [\n                        450,\n                        18.3\n                    ],\n                    [\n                        600,\n                        20\n                    ],\n                    [\n                        750,\n                        20.75\n                    ],\n                    [\n                        850,\n                        22.4\n                    ]\n                ],\n                \"measuredFlightTimesNote\": \"Video-timed at the firing range on 2026-09-02, muzzle flash to impact, about +-0.4 s; see docs/firing-range-measurements.md. The flight-time readout is a least-squares quadratic in mil through these five points, within 0.39 s of each, because the vacuum fit above runs 1.5 to 4.8 s short and no physical model fits the mortar. It is an empirical curve with no physics behind it.\"\n            }\n        },\n        \"spg\": {\n            \"low\": {\n                \"branch\": \"low\",\n                \"source\": \"firing-range-fit\",\n                \"muzzleVelocity\": 262.4,\n                \"dragPerMeter\": 0.00039,\n                \"angleOffsetDeg\": 2.254,\n                \"anglePerMilDeg\": 0.05625,\n                \"rmsMeters\": 19.7,\n                \"sourceNote\": \"One continuous elevation scale shared with the high arc, 0.05625 deg/mil being exactly 6400 mils to a circle. Fitted over twelve measured dials from 150 to 1380 mil plus three flight times: 19.7 m RMS, worst residual about -37 m at 150 mil, flight times within 0.35 s. Nothing below 150 mil was measured; the 35 and 100 mil dials are extrapolated.\"\n            },\n            \"high\": {\n                \"branch\": \"high\",\n                \"source\": \"firing-range-fit\",\n                \"muzzleVelocity\": 262.4,\n                \"dragPerMeter\": 0.00039,\n                \"angleOffsetDeg\": 2.254,\n                \"anglePerMilDeg\": 0.05625,\n                \"rmsMeters\": 19.7,\n                \"sourceNote\": \"Same fit as the low arc, on the steep side of the model's maximum-range angle. The 1380 mil row is the weakest measurement, the mean of two shots in a dial whose five repeats spread 45 m.\"\n            }\n        }\n    }\n}\n"
          },
