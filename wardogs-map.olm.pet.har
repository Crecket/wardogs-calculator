              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=ZrprmPdDUha58e958FLcVSupgFMNFElawgShx3u%2FXIb6KDKKK62D4%2FT436GeGxy0gnUSlWPU0wqkuy0nTFAhZlTqHddz3QEC5kGdDfvdfM9ZLT3pTtZt5PO%2F8Ns%2FGMbujbw7EAPP\"}]}"
