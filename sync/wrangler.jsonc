{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "wardogs-sync",
    "main": "src/index.js",
    "compatibility_date": "2026-04-07",

    "observability": {
        "enabled": true
    },

    "durable_objects": {
        "bindings": [
            {
                "name": "ROOM",
                "class_name": "Room"
            }
        ]
    },

    // SQLite-backed: required on the Workers Free plan, and the only
    // backend where a room's drawings can exceed the 128 KiB per-value
    // cap that key-value storage would impose.
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["Room"]
        }
    ],

    "vars": {
        // Comma-separated list of origins allowed to create rooms.
        // "*" allows any. Joining an existing room is a WebSocket
        // upgrade and is gated by the room code, not by this.
        "ALLOWED_ORIGINS": "*"
    }
}
