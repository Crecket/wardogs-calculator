# Deployment-specific settings. Copy to .env and fill in:
#
#   cp env.example .env
#
# .env is gitignored. It is read by both `npm run build` and `npm run dev`,
# so development behaves like a deployed build.
#
# These are NOT committed into config/app.json or maps/*.json on purpose:
# this repo is a fork, and keeping those files identical to upstream means
# merges never conflict over one deployment's URLs. A clone with no .env
# still builds a working, fully self-contained site.


# --- Shared sessions (optional) -------------------------------------------
# WebSocket URL of the sync Worker in sync/. Leave unset and the
# collaboration feature disables itself entirely: no toolbar button, no
# network calls.
#
# Local development, with `npm run dev:sync` running in another terminal:
#COLLAB_URL=ws://localhost:8799
# Deployed:
#COLLAB_URL=wss://wardogs-map-sync.olm.pet


# --- Remote map tiles (optional) ------------------------------------------
# Serve the tile pyramids from object storage instead of bundling them.
#
# They are ~43,700 files and 1.4 GB, over the 20,000-file cap on a
# Cloudflare Pages deployment. Setting this drops the built site to a few
# hundred files and leaves tiles out of dist/ entirely.
#
# Upload them once with: npm run sync-tiles
#TILE_BASE_URL=https://wardogs-tiles.olm.pet


# --- R2 credentials, for `npm run sync-tiles` -----------------------------
# Cloudflare dashboard -> R2 -> Manage API tokens.
# Needs Object Read & Write on the bucket.
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=wardogs-tiles
